# =========================
# DeepSeek Configuration
# =========================

DEEPSEEK_API_KEY=your_api_key_here

# Model
DEEPSEEK_MODEL=deepseek-chat

# API Base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Multi-Model Router providers
KIMI_API_KEY=your_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
QWEN_API_KEY=your_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_API_KEY=your_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional route override example
# MODEL_ROUTER_ARCHITECTURE_STANDARD_PRIMARY_MODEL=deepseek-v4-flash

# =========================
# Unity Compiler
# =========================

UNITY_EDITOR_PATH=D:\Unity\Hub\Unity_Editor\2022.3.62f2c1\Editor\Unity.exe
UNITY_TEST_PROJECT_PATH=D:\Unity\Unity_Project\CodingAgentTest

# Independent runtime repositories and state
GENERATED_SOURCE_PATH=D:\path\to\generated-code-repository
GENERATED_TEST_SOURCE_PATH=D:\path\to\runtime-state\generated-tests
WORKFLOW_CHECKPOINT_PATH=D:\path\to\runtime-state\workflow.sqlite

# =========================
# Unity Worker (Day19)
# =========================

# Local is the only enabled mode until the opt-in HTTPS adapter is configured.
UNITY_WORKER_MODE=local
UNITY_WORKER_STATE_PATH=D:\path\to\runtime-state\unity-worker
UNITY_WORKER_TIMEOUT_SECONDS=900
UNITY_WORKER_RESULT_RETENTION_DAYS=7

# Jobs default to disabled network access. Set this to true only when the
# worker environment actually enforces OS/container network isolation.
UNITY_WORKER_NETWORK_MODE=disabled
UNITY_WORKER_NETWORK_ISOLATION_ENFORCED=false

# =========================
# Local Approval Identity + Audit (Day17)
# =========================

# Roles: viewer | reviewer | approver | operator
APPROVAL_ACTOR_ID=local-maintainer
APPROVAL_ACTOR_ROLE=approver
APPROVAL_AUDIT_PATH=D:\path\to\runtime-state\approval_audit.jsonl

# =========================
# Read-Only Team Observation
# =========================

# Disabled by default. Use a unique 32-256 character token when enabled.
OBSERVATION_ENABLED=false
OBSERVATION_READ_TOKEN=replace_with_a_unique_read_only_token
OBSERVATION_SERVER_NAME=127.0.0.1
OBSERVATION_SERVER_PORT=7860
OBSERVATION_INSTANCE_ID=local-studio

# Configure both files for HTTPS. For LAN-only development without TLS,
# OBSERVATION_ALLOW_INSECURE_HTTP=true is an explicit interception-risk acknowledgement.
OBSERVATION_TLS_CERTFILE=
OBSERVATION_TLS_KEYFILE=
OBSERVATION_ALLOW_INSECURE_HTTP=false
